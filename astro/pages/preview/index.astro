---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PlotPage from "../../components/PlotPage.astro";
import { getDbClient } from "../../lib/db.js";
import { previewContext, previewViewer } from "../../lib/context.js";
import { autoReloadScript } from "../../lib/preview.js";
import { resolvePageView } from "../../../src/render/page.js";
import { guardAuth } from "../../../src/admin/server/auth.js";
import {
  getLatestSiteTemplateRevision,
  getLatestSiteTemplateRevisionId,
} from "../../../src/shared/site-bundle.js";

if (guardAuth(Astro.request)) return Astro.redirect("/admin/login");

const db = await getDbClient();
const ctx = await previewContext(db);
const viewer = previewViewer(Astro.request);

const [template, revisionId] = await Promise.all([
  getLatestSiteTemplateRevision(db, ctx.tenantId),
  getLatestSiteTemplateRevisionId(db, ctx.tenantId),
]);

const view = await resolvePageView(db, ctx, viewer, { kind: "home" }, template, Astro.response);

// Set after resolving: a draft is never indexable, whatever the page itself
// asked for, so this deliberately overwrites the per-page rule.
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow, noai, noimageai");

if (!view.page) Astro.response.status = 404;

const reload = autoReloadScript({
  revisionId,
  endpoint: `${ctx.urlPrefix}/revision.json`,
  loginHref: "/admin/login",
});
---
<SiteLayout options={view.layout} templateOverride={view.template}>
  <PlotPage view={view} ctx={ctx} />
  <script is:inline set:html={reload}></script>
</SiteLayout>
