---
/**
 * Site identity split by purpose and this page retired: what shows *on* the
 * site (name, tagline, logo) is Design → Brand, and what shows *elsewhere*
 * (favicon, social image) is Settings → Sharing & SEO. Custom token values went
 * to Settings too.
 *
 * The route stays mounted and redirects so an old link still lands somewhere.
 * `/editor/site/save` is untouched — both new screens post to it.
 */
import { requireAdminContext } from "nobodyreads/astro/context";

const ctx = requireAdminContext(Astro.locals);
return Astro.redirect(`${ctx.adminBase}/layout`, 301);
---
