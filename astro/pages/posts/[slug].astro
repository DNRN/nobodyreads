---
import SiteLayout from "../../layouts/SiteLayout.astro";
import ShareBar from "../../components/ShareBar.astro";
import Paywall from "../../components/Paywall.astro";
import { getPageBySlug, getNavItems } from "../../../src/content/db.js";
import { renderContent } from "../../../src/content/render.js";
import { DEFAULT_TENANT_ID } from "../../../src/shared/types.js";
import { isAuthenticatedRequest } from "../../../src/admin/server/auth.js";
import { getDbClient } from "../../lib/db.js";
import { gatePage } from "../../lib/gate.js";
import { formatDate } from "../../lib/format.js";

const tenantId = process.env.TENANT_ID || DEFAULT_TENANT_ID;
const urlPrefix = process.env.URL_PREFIX || "";
const siteName = process.env.SITE_NAME || "nobodyreads.me";

const db = await getDbClient();
const slug = Astro.params.slug || "";

const [rawPage, navItems] = await Promise.all([
  getPageBySlug(db, slug, "post", tenantId),
  getNavItems(db, tenantId),
]);

if (rawPage?.seo?.noAiTraining) {
  Astro.response.headers.set("X-Robots-Tag", "noai, noimageai");
}

// The gate returns a redacted page which shadows the raw one from here on, so
// the body, `options.page` (and therefore og:image) and anything else
// downstream are safe without each of them knowing about paywalls.
const gate = rawPage
  ? await gatePage(db, rawPage, tenantId, Astro.request, Astro.response)
  : null;
const page = gate?.page ?? null;
const isTeaser = gate?.gated === true && gate.decision.visibility === "teaser";

let htmlBody = "";
if (page) {
  htmlBody = await renderContent(db, page.content, tenantId, urlPrefix, {
    pageTitle: page.title,
  });
} else {
  Astro.response.status = 404;
}

const adminHref = `${urlPrefix}/admin`;
const loggedIn = isAuthenticatedRequest(Astro.request);
const menuItems = [
  loggedIn ? { label: "Admin", href: adminHref } : { label: "Log in", href: adminHref },
];
const options = page
  ? {
      title: `${page.title} — ${siteName}`,
      navItems,
      activePageId: page.id,
      scripts: page.scripts,
      description: page.seo?.metaDescription || page.excerpt,
      pathname: `${urlPrefix}/posts/${page.slug}`,
      ogType: "article",
      seo: page.seo,
      page,
      urlPrefix,
      siteName,
      menuItems,
    }
  : {
      title: `404 — ${siteName}`,
      navItems,
      seo: { noIndex: true },
      urlPrefix,
      siteName,
      menuItems,
    };
---
<SiteLayout options={options}>
  {page ? (
    <>
      <div class="post-header">
        <h1 class="post-title">{page.title}</h1>
        <div class="post-meta">
          <time class="post-date" datetime={page.date}>{formatDate(page.date)}</time>
          {page.tags.map((tag) => <span class="post-tag">{tag}</span>)}
        </div>
      </div>
      <div class:list={["post-body", isTeaser && "post-body--teaser"]} set:html={htmlBody} />
      {gate?.gated && gate.decision.visibility === "teaser" && (
        <Paywall
          decision={gate.decision}
          apiBase={`${urlPrefix}/api`}
          pageId={page.id}
          loginHref={`${urlPrefix}/login`}
          signedIn={gate.signedIn}
          siteName={siteName}
        />
      )}
      <ShareBar
        url={`${process.env.SITE_URL || ""}${urlPrefix}/posts/${page.slug}`}
        title={page.title}
        excerpt={page.excerpt}
      />
      <div
        class="nb-community"
        data-community
        data-likes-only
        data-api-base={`${urlPrefix}/api`}
        data-login-href={`${urlPrefix}/login`}
        data-slug={page.slug}
      ></div>
    </>
  ) : (
    <>
      <div class="post-header">
        <h1 class="post-title">Not found</h1>
      </div>
      <p>There's nothing here.</p>
      <a href={urlPrefix || "/"} class="back-link">&larr; back to home</a>
    </>
  )}
</SiteLayout>
