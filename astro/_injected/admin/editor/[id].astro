---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import PageEditor from "../../../components/admin/PageEditor.svelte";
import { requireAdminContext } from "nobodyreads/astro/context";
import { initDb, getPageById, resolveSiteName } from "nobodyreads";

const ctx = requireAdminContext(Astro.locals);
const previewBase = `${ctx.siteBase.replace(/\/$/, "")}/preview`;

const { id } = Astro.params;
if (!id || id === "new" || id === "save" || id === "login" || id === "delete") {
  return Astro.redirect(`${ctx.editorBase}`);
}

const db = await initDb();
const page = await getPageById(db, id, ctx.tenantId);
if (!page) {
  return Astro.redirect(`${ctx.editorBase}`);
}

// The home page has no title of its own, so it is named after the site both in
// this tab and in the hidden field the editor submits.
const siteName = await resolveSiteName(db, ctx.tenantId, ctx.siteName);
const editorTitle = page.kind === "home" ? siteName : page.title;
---
<AdminLayout
  title={`Edit: ${editorTitle} — Admin`}
  adminBase={ctx.adminBase}
  siteBase={ctx.siteBase}
>
  <PageEditor
    client:load
    page={page}
    editorBase={ctx.editorBase}
    adminBase={ctx.adminBase}
    previewBase={previewBase}
    siteName={siteName}
  />
</AdminLayout>
