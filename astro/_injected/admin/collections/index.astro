---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireAdminContext } from "nobodyreads/astro/context";
import { initDb, listContentViews, auditCustomViews } from "nobodyreads";

const ctx = requireAdminContext(Astro.locals);
const collectionsBase = `${ctx.adminBase}/collections`;

const db = await initDb();
const views = await listContentViews(db, ctx.tenantId);

// Custom view queries are checked against a table allowlist. Stored queries are
// never rewritten for the author, so a view that no longer passes just stops
// rendering — surface that here rather than letting it fail silently.
const issues = await auditCustomViews(db, ctx.tenantId);
---
<AdminLayout title="Collections — Admin" adminBase={ctx.adminBase} siteBase={ctx.siteBase}>
  <main class="container">
    <div class="editor-list">
      <div class="editor-list-header">
        <h2>Collections</h2>
        <a href={`${collectionsBase}/new`} class="btn btn-primary">New collection</a>
      </div>
      <p class="hint">Embed in markdown using <code>{"{{collection:slug}}"}</code>. You can include more than one per page.</p>
      {issues.length > 0 && (
        <div class="view-audit">
          <strong>{issues.length === 1 ? "One collection is not running" : `${issues.length} collections are not running`}</strong>
          <p>
            Custom collection queries may only read <code>page_public</code>, <code>post_like</code>,
            <code>comment</code>, <code>content_view</code> and <code>media</code>, and must scope
            results with <code>:tenant_id</code>. Edit the query — usually <code>FROM page</code>
            becomes <code>FROM page_public</code>.
          </p>
          <ul>
            {issues.map((issue) => (
              <li><a href={`${collectionsBase}/${issue.id}`}>{issue.title}</a> — {issue.error}</li>
            ))}
          </ul>
        </div>
      )}
      {views.length === 0 ? (
        <div class="nr-empty">
          <div class="nr-empty-icon">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
          </div>
          <div class="nr-empty-title">Nothing here yet</div>
          <p class="nr-empty-sub">Zero collections, beautifully rendered. Create your first reusable collection to get going.</p>
        </div>
      ) : (
        <table class="editor-table">
          <thead>
            <tr><th>Title</th><th>Slug</th><th>Kind</th><th>Status</th><th>Updated</th></tr>
          </thead>
          <tbody>
            {views.map((view) => (
              <tr>
                <td><a href={`${collectionsBase}/${view.id}`}>{view.title}</a></td>
                <td class="cell-slug">{view.slug}</td>
                <td>{view.kind}</td>
                <td class="cell-status">
                  {view.published
                    ? <span class="badge badge-published">published</span>
                    : <span class="badge badge-draft">draft</span>}
                </td>
                <td class="cell-date">{view.updated || "-"}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>
  </main>
</AdminLayout>

<style>
  .view-audit {
    margin: 0 0 1rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--nr-warn-border, #e0b750);
    border-left-width: 3px;
    border-radius: 6px;
    background: var(--nr-warn-bg, #fdf6e3);
    color: var(--nr-warn-fg, #5c4813);
    font-size: 0.9rem;
  }
  .view-audit p { margin: 0.4rem 0 0; }
  .view-audit ul { margin: 0.5rem 0 0; padding-left: 1.1rem; }
  .view-audit li { margin: 0.2rem 0; }
  .view-audit code { font-size: 0.85em; }
</style>
