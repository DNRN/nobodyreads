---
/**
 * AI theming moved into Design as its own tab. This route stays mounted and
 * redirects, so a bookmark or an old link still lands somewhere useful.
 */
import { requireAdminContext } from "nobodyreads/astro/context";

const ctx = requireAdminContext(Astro.locals);
return Astro.redirect(`${ctx.adminBase}/layout`, 301);
