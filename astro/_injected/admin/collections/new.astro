---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import CollectionEditor from "../../../components/admin/CollectionEditor.svelte";
import { requireAdminContext } from "nobodyreads/astro/context";

const ctx = requireAdminContext(Astro.locals);
const collectionsBase = `${ctx.adminBase}/collections`;
---
<AdminLayout
  title="New View — Admin"
  adminBase={ctx.adminBase}
  siteBase={ctx.siteBase}
>
  <CollectionEditor client:load collectionsBase={collectionsBase} />
</AdminLayout>
