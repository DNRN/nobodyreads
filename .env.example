# ─── Database ────────────────────────────────────────
# Local SQLite (default):  file:data/blog.db
# Turso (managed):         libsql://your-db.turso.io
DATABASE_URL=file:data/blog.db
TURSO_AUTH_TOKEN=

# ─── Server ──────────────────────────────────────────
PORT=3000
NODE_ENV=development
SITE_URL=http://localhost:3000
SITE_NAME=My Blog
SITE_TAGLINE=Another simple blog engine. For writing mostly to yourself.

# ─── Editor ──────────────────────────────────────────
# Set a password to protect the editor. Leave blank for open access.
EDITOR_PASSWORD=

# ─── Community federation (optional) ─────────────────
# Register this space with a community hub (see the hub's federation API),
# then paste the issued credentials here to enable "Sign in with the community".
# Leave blank to keep federation disabled.
# FEDERATION_ISSUER_URL=https://your-community-hub.example
# FEDERATION_CLIENT_ID=
# FEDERATION_CLIENT_SECRET=
# Optional friendly name shown on the login page (defaults to the hub origin):
# FEDERATION_ISSUER_NAME=The Community
# Secret used to sign federated member session cookies. Set in production so
# sessions survive restarts; falls back to MEMBER_SESSION_SECRET or an
# ephemeral key when unset.
# FEDERATION_SESSION_SECRET=

# ─── AI theming (optional) ───────────────────────────
# Enables the AI theme assistant in the layout editor. Leave unset to hide it.
# AI_PROVIDER selects the backend: openai-compatible (default) | anthropic |
# gemini | local. openai-compatible covers OpenAI, OpenRouter, Together, Groq,
# vLLM, and most hosted open-model gateways.
# AI_PROVIDER=openai-compatible
# OPENAI_API_KEY=                       # required for hosted providers (not local)
# OPENAI_BASE_URL=https://api.openai.com/v1   # override endpoint / gateway
# AI_THEME_MODEL=gpt-4o-mini            # model id for the selected provider
# Key used to encrypt secrets stored at rest (e.g. a tenant's BYO AI key).
# 32 bytes as hex/base64, or any string (SHA-256-derived). Rotating it
# invalidates stored secrets. Required to save BYO provider keys.
# SETTINGS_ENC_KEY=

# ─── Media storage ────────────────────────────────────
# Media storage is configured via a JSON file, not env vars.
# Default location: config/storage.config.json (see config/storage.config.example.json).
# Without that file, uploads are stored locally in media/.
# Override the config file location if needed:
# STORAGE_CONFIG=/absolute/path/to/storage.config.json

# ─── Email subscriptions (optional) ──────────────────
# Email is configured via a JSON file, not env vars.
# Default location: config/email.config.json (see config/email.config.example.json).
# Without that file (or with "enabled": false), subscriptions stay off.
# Override the config file location if needed:
# EMAIL_CONFIG=/absolute/path/to/email.config.json

# ─── Payments (optional, self-host) ──────────────────
# Your own Stripe keys. With these set, paid tiers and single-post purchases
# work with no commission and no Connect — you are the merchant.
# Leave unset to keep payments off; gating still works, there is just no way
# for a reader to buy access.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...        # from `stripe listen` or the dashboard
# Days of grace added to a subscription's period end before access lapses, so a
# card failing on renewal day does not lock a reader out mid-dunning.
# ENTITLEMENT_GRACE_SECONDS=259200
