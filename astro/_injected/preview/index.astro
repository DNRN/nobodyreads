---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PlotPage from "../../components/PlotPage.astro";
import { requireAdminContext, requireSiteContext } from "nobodyreads/astro/context";

import {
  initDb,
  resolvePageView,
  autoReloadScript,
  readScratchTemplate,
  previewSurface,
  getLatestSiteTemplateRevision,
  getLatestSiteTemplateRevisionId,
} from "nobodyreads";

// Preview shows unsaved drafts, so it is owner-only. The host middleware is
// responsible for auth and for publishing both contexts; injected pages only
// read from them.
const admin = requireAdminContext(Astro.locals);
const ctx = previewSurface(requireSiteContext(Astro.locals));

// Owner-only route by construction, so the viewer is the owner. `?preview=`
// lets them look at their own page through a reader's eyes; the gate ignores
// it for anyone else, so it is not a way in.
const param = new URL(Astro.request.url).searchParams.get("preview");
const viewer = {
  isOwner: true,
  member: null,
  previewAs:
    param === "public" || param === "member" || param === "owner" ? param : null,
} as const;

const db = await initDb();
// A template the editor is holding but has not saved wins over the last saved
// draft — it is what the author is looking at right now.
const scratch = await readScratchTemplate(Astro.request);
const [saved, revisionId] = await Promise.all([
  scratch ? null : getLatestSiteTemplateRevision(db, ctx.tenantId),
  getLatestSiteTemplateRevisionId(db, ctx.tenantId),
]);
const template = scratch ?? saved;

const view = await resolvePageView(db, ctx, viewer, { kind: "home" }, template, Astro.response);

// Set after resolving: a draft is never indexable, whatever the page asked for.
Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow, noai, noimageai");

if (!view.page) Astro.response.status = 404;

// Only a GET render polls for new revisions. A scratch render arrived by POST,
// so reloading it would re-submit the form — and the editor drives its own
// updates anyway, so there is nothing to poll for.
const reload = scratch
  ? null
  : autoReloadScript({
  revisionId,
  endpoint: `${ctx.urlPrefix}/revision.json`,
  loginHref: admin.loginHref,
    });
---
<SiteLayout options={view.layout} templateOverride={view.template}>
  <PlotPage view={view} ctx={ctx} />
  {reload && <script is:inline set:html={reload}></script>}
</SiteLayout>
