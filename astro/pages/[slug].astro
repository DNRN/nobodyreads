---
import SiteLayout from "../layouts/SiteLayout.astro";
import PlotPage from "../components/PlotPage.astro";
import { getDbClient } from "../lib/db.js";
import { siteContext, siteViewer } from "../lib/context.js";
import { resolvePageView } from "../../src/render/page.js";
import { getSiteTemplate } from "../../src/shared/site-bundle.js";

const db = await getDbClient();
const ctx = await siteContext(db);
const viewer = await siteViewer(db, Astro.request);
const template = await getSiteTemplate(db, ctx.tenantId);

const view = await resolvePageView(
  db,
  ctx,
  viewer,
  { kind: "page", slug: Astro.params.slug || "" },
  template,
  Astro.response,
);

// Content that moved (post <-> page, renamed) leaves its old address behind.
if (view.redirectTo) return Astro.redirect(view.redirectTo, 301);
if (!view.page) Astro.response.status = 404;
---
<SiteLayout options={view.layout} templateOverride={view.template}>
  <PlotPage view={view} ctx={ctx} />
</SiteLayout>
