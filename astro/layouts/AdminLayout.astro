---
import { buildAdminNav, buildCreateMenu, getAdminContext } from "nobodyreads/astro/context";

const {
  title = "Admin",
  adminBase = "/admin",
  siteBase = "/",
  scripts = "",
  fullWidth = false,
  chrome = true,
  activeHref,
} = Astro.props as {
  title?: string;
  adminBase?: string;
  siteBase?: string;
  scripts?: string;
  fullWidth?: boolean;
  chrome?: boolean;
  /** Nav item to highlight when the URL alone cannot tell (see `AdminNavLocation`). */
  activeHref?: string;
};

const adminCtx = getAdminContext(Astro.locals);
// A host with its own session (e.g. a platform-wide cookie) overrides where
// "Sign out" posts; otherwise fall back to the package's own EDITOR_PASSWORD
// logout endpoint.
const logoutHref = adminCtx?.logoutHref ?? `${adminBase}/logout`;
// A multi-tenant host points the wordmark at its own apex — a "back to the
// central hub" link. A self-hosted, single-tenant deployment has no wider hub,
// so it falls back to the dashboard's own root.
const homeUrl = adminCtx?.homeUrl ?? adminBase;

// AI and payments flags come from the admin context so no per-page prop
// threading is required; hiding Earnings is presentation, never a gate.
const navGroups = buildAdminNav(
  {
    adminBase,
    aiEnabled: adminCtx?.aiEnabled,
    paymentsEnabled: adminCtx?.paymentsEnabled,
    hostNav: adminCtx?.hostNav,
  },
  { pathname: Astro.url.pathname, search: Astro.url.search, activeHref }
);
const createMenu = buildCreateMenu({
  adminBase,
  editorBase: adminCtx?.editorBase ?? `${adminBase}/editor`,
});

const devReload = import.meta.env.DEV
  ? `  <script>new EventSource("/__reload").onmessage = e => { if (e.data === "reload") location.reload(); };</script>`
  : "";

// Simple 17px line icons (stroke currentColor, width 1.8), keyed by nav item id.
// Inlined so the engine keeps no icon dependency.
const navIcons: Record<string, string> = {
  dashboard: `<path d="M3 10.5 12 4l9 6.5"/><path d="M5 9.5V20h14V9.5"/>`,
  posts: `<rect x="5" y="3" width="14" height="18" rx="2.4"/><path d="M8.5 8.5h7M8.5 12h7M8.5 15.5h4.5"/>`,
  // A dog-eared sheet: one standalone page.
  pages: `<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5"/>`,
  media: `<rect x="4" y="5" width="16" height="14" rx="2.4"/><circle cx="9" cy="10" r="1.7"/><path d="m5 17 4.5-4 4 3.5L17 12l3 3"/>`,
  design: `<path d="M14 4l6 6-8.5 8.5L5 20l1.5-6.5z"/><path d="M11 7l6 6"/>`,
  // Stacked cards: a collection is a set of posts, not something you "look at".
  collections: `<rect x="3" y="8.5" width="13" height="12" rx="2.2"/><path d="M7 5.5h11a2 2 0 0 1 2 2v9"/>`,
  subscribers: `<circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-5 6-5s6 1.7 6 5"/><path d="M16 5.6a3 3 0 0 1 0 5.8"/><path d="M21 20c0-2.4-1.3-4-3.4-4.6"/>`,
  comments: `<path d="M20 15a2 2 0 0 1-2 2H8l-4 4V6a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2z"/><path d="M8.5 9h7M8.5 12.5h4.5"/>`,
  earnings: `<rect x="2.5" y="5.5" width="19" height="13" rx="2.4"/><path d="M2.5 10h19"/><path d="M6 14.5h3.5"/>`,
  site: `<circle cx="12" cy="12" r="3"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6 7 7M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"/>`,
  // Host items without an icon of their own.
  generic: `<circle cx="12" cy="12" r="3.5"/>`,
};

function navIcon(item: { id: string; icon?: string }): string {
  const body = item.icon ?? navIcons[item.id] ?? navIcons.generic;
  return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${body}</svg>`;
}
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="32x32">
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16">
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32">
    <link rel="apple-touch-icon" href="/apple-touch-icon.png">
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem("theme");
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          const theme = (stored === "system" || !stored)
            ? (prefersDark ? "dark" : "light")
            : (stored === "dark" || stored === "light"
                ? stored
                : (prefersDark ? "dark" : "light"));
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400;1,6..72,500&display=swap"
      />
    </noscript>
    <link rel="stylesheet" href="/editor.css" />
    <Fragment set:html={devReload} />
  </head>
  <body>
    {chrome ? (
    <div class="nr-admin">
      <header class="nr-admin-header">
        <div class="nr-admin-header-left">
          <button class="nr-admin-hamburger" id="sidebar-toggle" type="button" aria-label="Toggle navigation">
            <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 010 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 010 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 010 2H4a1 1 0 01-1-1z" clip-rule="evenodd" /></svg>
          </button>
          <a class="nr-admin-logo" href={homeUrl}>nobodyreads<span class="nr-dot">.</span></a>
        </div>
        <div class="nr-admin-header-right">
          <a href={siteBase} target="_blank">View site ↗</a>
          <button
            type="button"
            class="nr-admin-theme-toggle"
            data-theme-toggle
            title="Toggle theme"
            aria-label="Toggle theme"
          >
            <svg class="nr-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="nr-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9 6.3 6.3M17.7 17.7l1.4 1.4M19.1 4.9 17.7 6.3M6.3 17.7 4.9 19.1"/></svg>
          </button>
          <form method="POST" action={logoutHref} style="margin:0">
            <button type="submit" class="btn btn-ghost">Sign out</button>
          </form>
        </div>
      </header>

      <div class="nr-admin-body">
        <div class="nr-admin-sidebar-overlay" id="sidebar-overlay"></div>
        <aside class="nr-admin-sidebar" id="admin-sidebar">
          <div class="nr-create" data-create-menu>
            <a class="nr-create-main" href={createMenu.primary.href}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
              New post
            </a>
            <button
              type="button"
              class="nr-create-toggle"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="nr-create-menu"
              aria-label="More to create"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
            </button>
            <div class="nr-create-menu" id="nr-create-menu" role="menu" aria-label="Create" hidden>
              {createMenu.items.map((item) => (
                <>
                  {item.separatorBefore && <div class="nr-create-sep" role="separator"></div>}
                  <a class="nr-create-item" role="menuitem" href={item.href} tabindex="-1">
                    <span class="nr-create-item-label">{item.label}</span>
                    <span class="nr-create-item-hint">{item.hint}</span>
                  </a>
                </>
              ))}
            </div>
          </div>
          {navGroups.map((group) => (
            <>
              {group.label && <div class="nr-admin-nav-section">{group.label}</div>}
              {group.items.map((item) => (
                <a
                  href={item.href}
                  class:list={["nr-admin-nav-link", { active: item.active }]}
                  aria-current={item.active ? "page" : undefined}
                >
                  <Fragment set:html={navIcon(item)} />
                  {item.label}
                  {item.badge && <span class="nr-admin-nav-badge">{item.badge}</span>}
                </a>
              ))}
            </>
          ))}
          <div class="nr-admin-sidebar-footer">
            <div class="nr-admin-sidebar-quote">
              &ldquo;Nobody reads it anyway — and that&rsquo;s the point.&rdquo;
            </div>
          </div>
        </aside>
        <div class="nr-admin-content">
          <slot />
        </div>
      </div>
    </div>
    ) : (
    <div class="nr-admin">
      <slot />
    </div>
    )}
    <script src="/site.js" defer></script>
    <Fragment set:html={scripts} />
    <script is:inline>
      (function () {
        var toggle = document.getElementById("sidebar-toggle");
        var sidebar = document.getElementById("admin-sidebar");
        var overlay = document.getElementById("sidebar-overlay");
        if (!toggle || !sidebar || !overlay) return;
        function openSidebar() {
          sidebar.classList.add("open");
          overlay.classList.add("open");
        }
        function closeSidebar() {
          sidebar.classList.remove("open");
          overlay.classList.remove("open");
        }
        toggle.addEventListener("click", function () {
          if (sidebar.classList.contains("open")) closeSidebar();
          else openSidebar();
        });
        overlay.addEventListener("click", closeSidebar);
      })();
      // "New post" split button: the ▾ opens a menu (WAI-ARIA menu button).
      (function () {
        var root = document.querySelector("[data-create-menu]");
        if (!root) return;
        var toggle = root.querySelector(".nr-create-toggle");
        var menu = root.querySelector(".nr-create-menu");
        var items = Array.prototype.slice.call(menu.querySelectorAll("[role=menuitem]"));
        function open(focusIndex) {
          menu.hidden = false;
          toggle.setAttribute("aria-expanded", "true");
          items[focusIndex].focus();
        }
        function close(refocus) {
          if (menu.hidden) return;
          menu.hidden = true;
          toggle.setAttribute("aria-expanded", "false");
          if (refocus) toggle.focus();
        }
        toggle.addEventListener("click", function () {
          if (menu.hidden) open(0);
          else close(false);
        });
        toggle.addEventListener("keydown", function (e) {
          if (e.key === "ArrowDown") { e.preventDefault(); open(0); }
          else if (e.key === "ArrowUp") { e.preventDefault(); open(items.length - 1); }
        });
        menu.addEventListener("keydown", function (e) {
          var i = items.indexOf(document.activeElement);
          if (e.key === "ArrowDown") { e.preventDefault(); items[(i + 1) % items.length].focus(); }
          else if (e.key === "ArrowUp") { e.preventDefault(); items[(i - 1 + items.length) % items.length].focus(); }
          else if (e.key === "Home") { e.preventDefault(); items[0].focus(); }
          else if (e.key === "End") { e.preventDefault(); items[items.length - 1].focus(); }
          else if (e.key === "Escape") { e.preventDefault(); close(true); }
          else if (e.key === "Tab") close(false);
        });
        document.addEventListener("click", function (e) {
          if (!root.contains(e.target)) close(false);
        });
      })();
    </script>
  </body>
</html>
