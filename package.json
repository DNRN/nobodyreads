{
  "name": "nobodyreads",
  "version": "0.1.0",
  "description": "A simple, self-hosted blog engine. Markdown-first, server-rendered, zero client-side JS.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/db/schema/index.d.ts",
      "import": "./dist/db/schema/index.js"
    },
    "./storage": {
      "types": "./dist/media/storage.d.ts",
      "import": "./dist/media/storage.js"
    },
    "./email": {
      "types": "./dist/subscription/email.d.ts",
      "import": "./dist/subscription/email.js"
    },
    "./editor": {
      "types": "./dist/admin/client/index.d.ts",
      "import": "./dist/admin/client/index.js"
    },
    "./image-markdown": {
      "types": "./dist/shared/image-markdown.d.ts",
      "import": "./dist/shared/image-markdown.js"
    },
    "./embed-token": {
      "types": "./dist/shared/embed-token.d.ts",
      "import": "./dist/shared/embed-token.js"
    },
    "./slugify": {
      "types": "./dist/shared/slugify.d.ts",
      "import": "./dist/shared/slugify.js"
    },
    "./collection-template": {
      "types": "./dist/content/collection-template.d.ts",
      "import": "./dist/content/collection-template.js"
    },
    "./collection-presets": {
      "types": "./dist/content/collection-presets.d.ts",
      "import": "./dist/content/collection-presets.js"
    },
    "./editor/milkdown": {
      "types": "./dist/admin/client/milkdown/index.d.ts",
      "import": "./dist/admin/client/milkdown/index.js"
    },
    "./editor/styles": "./public/editor.css",
    "./astro": {
      "types": "./dist/astro/index.d.ts",
      "import": "./dist/astro/index.js"
    },
    "./astro/context": {
      "types": "./dist/astro/context.d.ts",
      "import": "./dist/astro/context.js"
    },
    "./astro/SiteLayout": "./astro/layouts/SiteLayout.astro",
    "./astro/ShareBar": "./astro/components/ShareBar.astro",
    "./astro/Paywall": "./astro/components/Paywall.astro",
    "./community": {
      "types": "./dist/community/index.d.ts",
      "import": "./dist/community/index.js"
    },
    "./federation": {
      "types": "./dist/federation/index.d.ts",
      "import": "./dist/federation/index.js"
    }
  },
  "bin": {
    "nobodyreads": "./dist/standalone.js"
  },
  "files": [
    "dist",
    "public",
    "astro/_injected",
    "astro/layouts",
    "astro/components",
    "config/storage.config.example.json",
    "config/email.config.example.json",
    "schema.sql",
    "robots.txt"
  ],
  "scripts": {
    "predev": "npm run generate:schema",
    "dev": "tsx watch src/standalone.ts",
    "predev:astro": "npm run generate:schema",
    "dev:astro": "astro dev",
    "dev:client": "tsx scripts/build-client.ts --watch",
    "prestart": "npm run generate:schema",
    "start": "NODE_ENV=production tsx src/standalone.ts",
    "generate:schema": "tsx scripts/generate-schema-module.ts",
    "prebuild": "npm run generate:schema",
    "build": "npm run build:palette && npm run build:client && astro build && tsc",
    "build:client": "tsx scripts/build-client.ts",
    "build:palette": "tsx scripts/build-palette-css.ts",
    "site:use-minimal-css": "tsx scripts/use-minimal-css.ts",
    "site:bootstrap": "tsx scripts/bootstrap-site.ts",
    "site:remove-site-script": "tsx scripts/remove-site-script.ts",
    "theme:smoke": "tsx scripts/theme-generation-smoke.ts",
    "pretest": "npm run generate:schema",
    "test": "vitest run",
    "pretypecheck": "npm run generate:schema",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.client.json",
    "post": "tsx scripts/publish.ts"
  },
  "keywords": [
    "blog",
    "markdown",
    "self-hosted",
    "blogging",
    "seo",
    "sqlite"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nobodyreads/nobodyreads"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@astrojs/node": "^11.1.2",
    "@astrojs/svelte": "^9.0.1",
    "@google-cloud/storage": "^8.0.0",
    "@google/genai": "^2.17.1",
    "@hono/node-server": "^2.1.1",
    "@hono/zod-validator": "^0.9.0",
    "@libsql/client": "^0.17.4",
    "@milkdown/crepe": "^7.22.1",
    "@milkdown/kit": "^7.22.1",
    "astro": "^7.2.2",
    "bcryptjs": "^3.0.3",
    "busboy": "^1.6.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.2",
    "marked": "^18.0.10",
    "openai": "^7.5.0",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.11",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.0",
    "prosemirror-view": "^1.42.2",
    "stripe": "^22.5.0",
    "svelte": "^5.56.9",
    "unist-util-visit": "^5.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@types/busboy": "^1.5.4",
    "@types/node": "^26.2.0",
    "codemirror": "^6.0.1",
    "crelt": "^1.0.7",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.9.6",
    "puppeteer-core": "^25.8.0",
    "remark-parse": "^11.0.0",
    "remark-stringify": "^11.0.0",
    "style-mod": "^4.1.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}
