---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { requireAdminContext } from "nobodyreads/astro/context";
import { initDb, listAllPages, countPendingFlags } from "nobodyreads";

const ctx = requireAdminContext(Astro.locals);

const db = await initDb();
const pages = await listAllPages(db, ctx.tenantId);
const pendingFlags = await countPendingFlags(db, ctx.tenantId);

const posts = pages.filter((p) => p.kind === "post");
const staticPages = pages.filter((p) => p.kind === "page");
const homePage = pages.find((p) => p.kind === "home");
const publishedPosts = posts.filter((p) => p.published).length;
const drafts = pages.filter((p) => !p.published).length;

const recent = [...posts].sort((a, b) => (a.date < b.date ? 1 : -1));
const resumePost = recent[0];

function formatDate(iso: string): string {
  const d = new Date(iso);
  return d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
}

const today = new Date().toLocaleDateString("en-GB", {
  weekday: "long",
  day: "numeric",
  month: "long",
});

// Sub-line stats, pluralized so a fresh site reads naturally.
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "s"}`;
const substat = `${plural(publishedPosts, "post")} out in the world · ${plural(drafts, "draft")} waiting · ${plural(staticPages.length, "page")}`;

// First-run checklist — nudges a brand-new site toward a real first post. Hidden
// once every step is done so it doesn't clutter an established site. A fresh site
// ships with a starter home page, so step one is about making it yours rather
// than creating one: it's "done" once the page has been saved at least once
// (the editor stamps `updated` on every edit).
const homePersonalized = !!homePage?.updated;
const checklist = [
  {
    done: homePersonalized,
    label: "Make the home page yours",
    href: homePage ? `${ctx.editorBase}/${homePage.id}` : `${ctx.editorBase}/new?kind=home`,
  },
  { done: posts.length > 0, label: "Write your first post", href: `${ctx.editorBase}/new?kind=post` },
  { done: publishedPosts > 0, label: "Publish a post", href: ctx.editorBase },
];
const setupTotal = checklist.length;
const setupDone = checklist.filter((c) => c.done).length;
const setupComplete = setupDone >= setupTotal;
const nextStep = checklist.find((c) => !c.done);
const setupPct = Math.round((setupDone / setupTotal) * 100);
---
<AdminLayout title="Home — Admin" adminBase={ctx.adminBase} siteBase={ctx.siteBase}>
  <main class="container">
    <div class="home-eyebrow">{today}</div>
    <h1 class="home-greeting">A quiet day to write.</h1>
    <p class="home-substat">{substat}</p>

    <div class="home-actions">
      <a href={`${ctx.editorBase}/new?kind=post`} class="btn btn-primary">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14M5 12h14"/></svg>
        New post
      </a>
      <a href={`${ctx.editorBase}/new?kind=page`} class="btn">New page</a>
    </div>

    {pendingFlags > 0 && (
      <a href={`${ctx.adminBase}/moderation`} class="setup-card" style="display:block; text-decoration:none">
        <div class="setup-card-row">
          <span class="setup-icon">⚑</span>
          <div class="setup-card-body">
            <div class="setup-card-title">{plural(pendingFlags, "comment")} awaiting review</div>
            <div class="setup-card-sub">Held by your discussion rules until you decide.</div>
          </div>
          <span class="btn btn-primary btn-sm">Review</span>
        </div>
      </a>
    )}

    {setupComplete ? (
      <div class="setup-done">
        <span class="setup-icon">✓</span>
        <div class="setup-card-body">
          <div class="setup-card-title">You're all set up.</div>
          <div class="setup-card-sub">Now go write. Nobody's stopping you.</div>
        </div>
      </div>
    ) : (
      <div class="setup-card">
        <div class="setup-card-row">
          <span class="setup-icon">✎</span>
          <div class="setup-card-body">
            <div class="setup-card-title">One thing left — {nextStep?.label.toLowerCase()}</div>
            <div class="setup-card-sub">{setupDone} of {setupTotal} setup steps done.</div>
          </div>
          <a href={nextStep?.href} class="btn btn-primary btn-sm">Finish</a>
        </div>
        <div class="setup-progress">
          <div class="setup-progress-fill" style={`width:${setupPct}%`}></div>
        </div>
      </div>
    )}

    {resumePost ? (
      <>
        <div class="section-label">Pick up where you left off</div>
        <a href={`${ctx.editorBase}/${resumePost.id}`} class="resume-card">
          <div>
            <div class="resume-eyebrow">
              {resumePost.published ? "Published" : "Draft"} · {formatDate(resumePost.date)}
            </div>
            <div class="resume-title">{resumePost.title}</div>
            <div class="resume-url">/posts/{resumePost.slug}</div>
          </div>
          <span class="resume-arrow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </a>
      </>
    ) : null}

    <div class="dashboard-grid">
      <a href={`${ctx.adminBase}/layout`} class="dashboard-card">
        <h3>Design</h3>
        <p>Template &amp; colors</p>
      </a>
      <a href={`${ctx.adminBase}/media`} class="dashboard-card">
        <h3>Media</h3>
        <p>Images &amp; files</p>
      </a>
      <a href={`${ctx.adminBase}/settings`} class="dashboard-card">
        <h3>Settings</h3>
        <p>Identity &amp; email</p>
      </a>
    </div>
  </main>
</AdminLayout>
