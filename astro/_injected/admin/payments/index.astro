---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { requireAdminContext } from "nobodyreads/astro/context";
import { initDb, getActivePaidTier, listAllPages } from "nobodyreads";

// Injected admin pages never call `guardAuth` — auth and the admin context are
// the host middleware's job, and a single-tenant host and a multi-tenant one
// authenticate completely differently. This page only reads from the context.
const ctx = requireAdminContext(Astro.locals);

const db = await initDb();
const [tier, pages] = await Promise.all([
  getActivePaidTier(db, ctx.tenantId),
  listAllPages(db, ctx.tenantId),
]);

const gated = pages.filter((p) => p.accessTier !== "public");
const paidPosts = gated.filter((p) => p.accessTier === "paid");
const memberPosts = gated.filter((p) => p.accessTier === "members");

function money(minorUnits: number | null | undefined, currency = "eur"): string {
  if (minorUnits == null) return "—";
  return new Intl.NumberFormat("en-IE", {
    style: "currency",
    currency: currency.toUpperCase(),
  }).format(minorUnits / 100);
}

function major(minorUnits: number | null | undefined): string {
  return minorUnits == null ? "" : (minorUnits / 100).toFixed(2);
}
---
<AdminLayout title="Payments — Admin" adminBase={ctx.adminBase} siteBase={ctx.siteBase}>
  <main class="container">
    <div class="editor-list">
      <div class="editor-list-header">
        <h2>Payments</h2>
      </div>
      <p class="hint">
        What your plot sells. Set one price, then mark posts as supporters-only
        in the editor.
      </p>

      <div class="editor-list-section">
        <h3>Supporter tier</h3>
        <form
          method="POST"
          action={`${ctx.editorBase.replace(/\/editor$/, "")}/payments/tier`}
          class="pay-form"
        >
          <div class="field">
            <label for="name">Name</label>
            <input type="text" id="name" name="name" maxlength="60"
                   value={tier?.name || "Supporter"} required />
          </div>
          <div class="field">
            <label for="amount_monthly">Per month</label>
            <input type="number" id="amount_monthly" name="amount_monthly"
                   step="0.01" min="0" value={major(tier?.amountMonthly)} />
          </div>
          <div class="field">
            <label for="amount_yearly">Per year <span class="hint">(optional)</span></label>
            <input type="number" id="amount_yearly" name="amount_yearly"
                   step="0.01" min="0" value={major(tier?.amountYearly)} />
          </div>
          <div class="field">
            <label class="checkbox-label">
              <input type="hidden" name="active" value="off" />
              <input type="checkbox" name="active" value="on" checked={tier?.active ?? true} />
              Offer this tier to readers
            </label>
          </div>
          <button type="submit" class="btn btn-primary">Save tier</button>
        </form>

        {tier && (
          <div class="env-status">
            <div class="env-row">
              <span class="env-label">Monthly</span>
              <span class="env-value">{money(tier.amountMonthly, tier.currency)}</span>
            </div>
            <div class="env-row">
              <span class="env-label">Yearly</span>
              <span class="env-value">{money(tier.amountYearly, tier.currency)}</span>
            </div>
          </div>
        )}
      </div>

      <div class="editor-list-section">
        <h3>What's behind the fold</h3>
        {gated.length === 0 ? (
          <p class="hint">
            Nothing is gated yet. Open a post in the editor and set
            <em>Who can read this</em>.
          </p>
        ) : (
          <>
            <div class="env-status">
              <div class="env-row">
                <span class="env-label">Supporters-only posts</span>
                <span class="env-value">{paidPosts.length}</span>
              </div>
              <div class="env-row">
                <span class="env-label">Members-only posts</span>
                <span class="env-value">{memberPosts.length}</span>
              </div>
            </div>

            <table class="editor-table">
              <thead>
                <tr><th>Title</th><th>Who can read it</th><th>Sold on its own</th></tr>
              </thead>
              <tbody>
                {gated.map((p) => (
                  <tr>
                    <td><a href={`${ctx.editorBase}/${p.id}`}>{p.title}</a></td>
                    <td>{p.accessTier === "paid" ? "Supporters" : "Members"}</td>
                    <td>{money(p.priceAmount, tier?.currency)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </>
        )}
      </div>
    </div>
  </main>
</AdminLayout>

<style>
  .pay-form { max-width: 26rem; }
  .pay-form .field { margin-bottom: 0.9rem; }
</style>
