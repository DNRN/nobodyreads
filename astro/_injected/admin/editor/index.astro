---
import AdminLayout from "../../../layouts/AdminLayout.astro";
import { contentListHref, requireAdminContext } from "nobodyreads/astro/context";
import { initDb, listAllPages, listMedia, resolveSiteName, type Page } from "nobodyreads";
import { formatDuration } from "nobodyreads/duration";

const ctx = requireAdminContext(Astro.locals);

const db = await initDb();
const pages = await listAllPages(db, ctx.tenantId);

// The home row is listed under the site's name: the home page has no title of
// its own, so its stored one is vestigial and would show whatever it was seeded
// with long after the site was renamed.
const siteName = await resolveSiteName(db, ctx.tenantId, ctx.siteName);

const groups: Record<string, Page[]> = { home: [], page: [], post: [] };
for (const page of pages) {
  const bucket = groups[page.kind] ?? [];
  bucket.push(page);
  groups[page.kind] = bucket;
}

function formatDate(iso: string): string {
  const d = new Date(iso);
  return d.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
  });
}

function kindLabel(kind: string): string {
  if (kind === "home") return "Home";
  if (kind === "post") return "Post";
  return "Page";
}

function viewUrl(p: Page): string {
  if (p.kind === "post") return `${ctx.siteBase.replace(/\/$/, "")}/posts/${p.slug}`;
  if (p.kind === "home") return ctx.siteBase;
  return `${ctx.siteBase.replace(/\/$/, "")}/${p.slug}`;
}

// Only one home page per site — if it exists, offer editing instead of creating.
const homePage = groups.home[0];

// The sidebar's Posts and Pages items open this list filtered to one kind; the
// bare URL lists everything.
const requested = Astro.url.searchParams.get("kind");
const filter = requested === "post" || requested === "page" ? requested : null;
const kinds: ("post" | "page")[] = filter ? [filter] : ["post", "page"];

const heading = filter === "post" ? "Posts" : filter === "page" ? "Pages" : "Content";
const intro =
  filter === "post"
    ? "Dated writing. Shows up in your feed and goes to subscribers."
    : filter === "page"
      ? "Standalone pages like About or Contact. Add them to your site's menu."
      : "Everything you've made, in one calm place.";
const newHref = `${ctx.editorBase}/new${filter === "page" ? "?kind=page" : ""}`;
const isEmpty = kinds.every((kind) => groups[kind].length === 0);

// Episodes show their length in the list; an audio draft without its file says
// so, since publishing waits for it. Media is only read when there are any.
const durations = new Map<string, number | null>();
if (groups.post.some((p) => p.format === "audio")) {
  for (const m of await listMedia(db, ctx.tenantId, (key) => key)) durations.set(m.id, m.durationSeconds ?? null);
}
function formatBadge(p: Page): string | null {
  if (p.format !== "audio") return null;
  if (!p.episode) return "episode · needs audio";
  const seconds = durations.get(p.episode.audioMediaId);
  return seconds ? `episode · ${formatDuration(seconds)}` : "episode";
}
---
<AdminLayout
  title={`${heading} — Admin`}
  adminBase={ctx.adminBase}
  siteBase={ctx.siteBase}
  activeHref={filter ? contentListHref(ctx.adminBase, filter) : undefined}
>
  <main class="container">
    <div class="editor-list">
      <div class="editor-list-header">
        <div>
          <h2>{heading}</h2>
          <p class="home-substat" style="margin-top:6px">{intro}</p>
        </div>
        {filter && (
          <a href={newHref} class="btn btn-primary btn-sm">{filter === "page" ? "New page" : "New post"}</a>
        )}
      </div>
      {filter !== "post" && (
      <section class="editor-home" aria-label="Home page">
        <div class="editor-home-main">
          <span class="editor-home-label">Home</span>
          {homePage ? (
            <a href={`${ctx.editorBase}/${homePage.id}`} class="editor-home-title">{siteName}</a>
          ) : (
            <p class="editor-home-empty">The front page of your site. Every site has exactly one.</p>
          )}
        </div>
        <div class="editor-home-meta">
          {homePage ? (
            <>
              {homePage.published
                ? <span class="badge badge-published">published</span>
                : <span class="badge badge-draft">draft</span>}
              <span class="editor-home-date">Last edited {formatDate(homePage.date)}</span>
            </>
          ) : (
            <a href={`${ctx.editorBase}/new?kind=home`} class="btn btn-sm btn-primary">Create home</a>
          )}
        </div>
      </section>
      )}
      {isEmpty ? (
        <p class="editor-empty">
          {filter === "page" ? "No pages yet." : "Nothing written yet."}{" "}
          <a href={newHref}>{filter === "page" ? "Make your first page" : "Write your first post"}</a>
        </p>
      ) : null}
      {kinds.map((kind) => {
        const items = groups[kind];
        if (items.length === 0) return null;
        return (
          <div class="editor-list-section">
            {!filter && <h3>{kindLabel(kind)}s</h3>}
            <table class="editor-table">
              <thead>
                <tr><th>Title</th><th>URL</th><th>Status</th><th>Date</th></tr>
              </thead>
              <tbody>
                {items.map((p) => {
                  const badge = formatBadge(p);
                  return (
                  <tr>
                    <td>
                      <a href={`${ctx.editorBase}/${p.id}`}>{p.title}</a>
                      {badge && <span class="badge badge-format">{badge}</span>}
                    </td>
                    <td class="cell-slug">{viewUrl(p)}</td>
                    <td class="cell-status">
                      {p.published
                        ? <span class="badge badge-published">published</span>
                        : <span class="badge badge-draft">draft</span>}
                    </td>
                    <td class="cell-date">{formatDate(p.date)}</td>
                  </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        );
      })}
    </div>
  </main>
</AdminLayout>
