---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { requireAdminContext } from "nobodyreads/astro/context";
import { initDb, listAllPages, countPendingFlags, countSubscribers } from "nobodyreads";

const ctx = requireAdminContext(Astro.locals);

const db = await initDb();
const pages = await listAllPages(db, ctx.tenantId);
const pendingFlags = await countPendingFlags(db, ctx.tenantId);
const subscribers = await countSubscribers(db, ctx.tenantId);

const posts = pages.filter((p) => p.kind === "post");
const staticPages = pages.filter((p) => p.kind === "page");
const homePage = pages.find((p) => p.kind === "home");
const publishedPosts = posts.filter((p) => p.published).length;
const drafts = pages.filter((p) => !p.published).length;

const recent = [...posts].sort((a, b) => (a.date < b.date ? 1 : -1));
const resumePost = recent[0];

function formatDate(iso: string): string {
  const d = new Date(iso);
  return d.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
}

const today = new Date().toLocaleDateString("en-GB", {
  weekday: "long",
  day: "numeric",
  month: "long",
});

// Sub-line stats, pluralized so a fresh site reads naturally.
const plural = (n: number, word: string) => `${n} ${word}${n === 1 ? "" : "s"}`;
const substat = `${plural(publishedPosts, "post")} out in the world · ${plural(drafts, "draft")} waiting · ${plural(staticPages.length, "page")}`;

// First-run checklist — the three things that take a new site from empty to
// read: make it look like yours, publish something, and tell people. Hidden once
// every step is done so it doesn't clutter an established site. A fresh site
// ships with a starter home page, so step one is about making it yours rather
// than creating one: it's "done" once the page has been saved at least once
// (the editor stamps `updated` on every edit).
const homePersonalized = !!homePage?.updated;
const latestDraft = recent.find((p) => !p.published);
const checklist: {
  done: boolean;
  label: string;
  sub: string;
  action: string;
  href?: string;
  /** Copy this (site-relative) URL instead of navigating. */
  copyUrl?: string;
}[] = [
  {
    done: homePersonalized,
    label: "Make the home page yours",
    sub: "It's the first thing a reader sees.",
    action: "Edit home",
    href: homePage ? `${ctx.editorBase}/${homePage.id}` : `${ctx.editorBase}/new?kind=home`,
  },
  {
    done: publishedPosts > 0,
    label: "Publish your first post",
    sub: "Publishing puts it on your site — and, if you choose, in your subscribers' inboxes.",
    action: latestDraft ? "Keep writing" : "Start writing",
    href: latestDraft ? `${ctx.editorBase}/${latestDraft.id}` : `${ctx.editorBase}/new`,
  },
  {
    done: subscribers.verified > 0,
    label: "Share your site",
    sub: "Anyone who subscribes gets every new post by email.",
    action: "Copy link",
    copyUrl: ctx.siteBase,
  },
];
const setupTotal = checklist.length;
const setupDone = checklist.filter((c) => c.done).length;
const setupComplete = setupDone >= setupTotal;
const nextStep = checklist.find((c) => !c.done);
const setupPct = Math.round((setupDone / setupTotal) * 100);

const stats = [
  { label: "Drafts", value: drafts },
  { label: "Published posts", value: publishedPosts },
  { label: "Subscribers", value: subscribers.verified },
];
---
<AdminLayout title="Dashboard — Admin" adminBase={ctx.adminBase} siteBase={ctx.siteBase}>
  <main class="container">
    <div class="home-eyebrow">{today}</div>
    <h1 class="home-greeting">A quiet day to write.</h1>
    <p class="home-substat">{substat}</p>

    <div class="home-stats">
      {stats.map((s) => (
        <div class="home-stat">
          <div class="home-stat-label">{s.label}</div>
          <div class="home-stat-value">{s.value}</div>
        </div>
      ))}
    </div>

    {pendingFlags > 0 && (
      <a href={`${ctx.adminBase}/moderation`} class="setup-card" style="display:block; text-decoration:none">
        <div class="setup-card-row">
          <span class="setup-icon">⚑</span>
          <div class="setup-card-body">
            <div class="setup-card-title">{plural(pendingFlags, "comment")} awaiting review</div>
            <div class="setup-card-sub">Held by your discussion rules until you decide.</div>
          </div>
          <span class="btn btn-primary btn-sm">Review</span>
        </div>
      </a>
    )}

    {setupComplete ? (
      <div class="setup-done">
        <span class="setup-icon">✓</span>
        <div class="setup-card-body">
          <div class="setup-card-title">You're all set up.</div>
          <div class="setup-card-sub">Now go write. Nobody's stopping you.</div>
        </div>
      </div>
    ) : (
      <section class="setup-card" aria-label="Getting started">
        <div class="setup-card-row">
          <span class="setup-icon">✎</span>
          <div class="setup-card-body">
            <div class="setup-card-title">Getting started</div>
            <div class="setup-card-sub">{setupDone} of {setupTotal} steps done.</div>
          </div>
        </div>
        <div class="setup-progress">
          <div class="setup-progress-fill" style={`width:${setupPct}%`}></div>
        </div>
        <ol class="setup-steps">
          {checklist.map((step) => (
            <li class:list={["setup-step", { "is-done": step.done }]}>
              <span class="setup-step-mark" aria-hidden="true">{step.done ? "✓" : ""}</span>
              <div class="setup-card-body">
                <div class="setup-step-title">{step.label}</div>
                <div class="setup-card-sub">{step.sub}</div>
              </div>
              {step.done ? (
                <span class="setup-step-state">Done</span>
              ) : step.copyUrl ? (
                <button
                  type="button"
                  class:list={["btn btn-sm", { "btn-primary": step === nextStep }]}
                  data-copy-url={step.copyUrl}
                >
                  {step.action}
                </button>
              ) : (
                <a href={step.href} class:list={["btn btn-sm", { "btn-primary": step === nextStep }]}>
                  {step.action}
                </a>
              )}
            </li>
          ))}
        </ol>
      </section>
    )}

    {resumePost ? (
      <>
        <div class="section-label">Pick up where you left off</div>
        <a href={`${ctx.editorBase}/${resumePost.id}`} class="resume-card">
          <div>
            <div class="resume-eyebrow">
              {resumePost.published ? "Published" : "Draft"} · {formatDate(resumePost.date)}
            </div>
            <div class="resume-title">{resumePost.title}</div>
            <div class="resume-url">/posts/{resumePost.slug}</div>
          </div>
          <span class="resume-arrow">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </span>
        </a>
      </>
    ) : null}
    <script is:inline>
      // "Copy link" resolves the site-relative URL against this origin, so the
      // author gets the address readers will actually use.
      document.querySelectorAll("[data-copy-url]").forEach(function (button) {
        button.addEventListener("click", function () {
          var url = new URL(button.getAttribute("data-copy-url"), location.origin).href;
          navigator.clipboard.writeText(url).then(
            function () { button.textContent = "Copied"; },
            function () { window.prompt("Copy your site's address:", url); }
          );
        });
      });
    </script>
  </main>
</AdminLayout>
