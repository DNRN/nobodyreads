---
import { getAdminContext } from "nobodyreads/astro/context";

const {
  title = "Admin",
  adminBase = "/admin",
  siteBase = "/",
  scripts = "",
  fullWidth = false,
  chrome = true,
} = Astro.props as {
  title?: string;
  adminBase?: string;
  siteBase?: string;
  scripts?: string;
  fullWidth?: boolean;
  chrome?: boolean;
};

// AI theming is only offered when the host has configured a provider. Read the
// flag from the admin context so no per-page prop threading is required.
const aiEnabled = getAdminContext(Astro.locals)?.aiEnabled ?? false;

const devReload = import.meta.env.DEV
  ? `  <script>new EventSource("/__reload").onmessage = e => { if (e.data === "reload") location.reload(); };</script>`
  : "";

const currentPath = Astro.url.pathname;

function isActive(href: string): boolean {
  if (href === adminBase) return currentPath === adminBase || currentPath === adminBase + "/";
  return currentPath.startsWith(href);
}

// Simple 17px line icons (stroke currentColor, width 1.8), keyed by nav label.
// Inlined so the engine keeps no icon dependency.
const navIcons: Record<string, string> = {
  Home: `<path d="M3 10.5 12 4l9 6.5"/><path d="M5 9.5V20h14V9.5"/>`,
  Content: `<rect x="5" y="3" width="14" height="18" rx="2.4"/><path d="M8.5 8.5h7M8.5 12h7M8.5 15.5h4.5"/>`,
  Media: `<rect x="4" y="5" width="16" height="14" rx="2.4"/><circle cx="9" cy="10" r="1.7"/><path d="m5 17 4.5-4 4 3.5L17 12l3 3"/>`,
  AI: `<path d="M12 3l1.7 4.4L18 9l-4.3 1.4L12 15l-1.7-4.6L6 9l4.3-1.6z"/>`,
  Design: `<path d="M14 4l6 6-8.5 8.5L5 20l1.5-6.5z"/><path d="M11 7l6 6"/>`,
  Views: `<path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>`,
  Community: `<circle cx="9" cy="8" r="3.2"/><path d="M3 20c0-3.3 2.7-5 6-5s6 1.7 6 5"/><path d="M16 5.6a3 3 0 0 1 0 5.8"/><path d="M21 20c0-2.4-1.3-4-3.4-4.6"/>`,
  Settings: `<circle cx="12" cy="12" r="3"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6 7 7M17 17l1.4 1.4M18.4 5.6 17 7M7 17l-1.4 1.4"/>`,
};

function navIcon(label: string): string {
  const body = navIcons[label] ?? "";
  return `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">${body}</svg>`;
}

// Grouped navigation: a small hierarchy beats six flat items. Each group has a
// clear job and room to grow (Audience → comments, Manage → domains/export).
const navGroups = [
  {
    label: "Create",
    items: [
      { href: adminBase, label: "Home" },
      { href: `${adminBase}/editor`, label: "Content" },
      { href: `${adminBase}/media`, label: "Media" },
    ],
  },
  {
    label: "Customize",
    items: [
      // AI first: describing a mood is more natural than hand-editing tokens.
      ...(aiEnabled ? [{ href: `${adminBase}/ai`, label: "AI" }] : []),
      { href: `${adminBase}/layout`, label: "Design" },
      { href: `${adminBase}/views`, label: "Views" },
    ],
  },
  {
    label: "Manage",
    items: [
      { href: `${adminBase}/community`, label: "Community" },
      { href: `${adminBase}/settings`, label: "Settings" },
    ],
  },
];
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem("theme");
          const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          const theme = (stored === "system" || !stored)
            ? (prefersDark ? "dark" : "light")
            : (stored === "dark" || stored === "light"
                ? stored
                : (prefersDark ? "dark" : "light"));
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap"
      media="print"
      onload="this.media='all'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500&display=swap"
      />
    </noscript>
    <link rel="stylesheet" href="/editor.css" />
    <Fragment set:html={devReload} />
  </head>
  <body>
    {chrome ? (
    <div class="nr-admin">
      <header class="nr-admin-header">
        <div class="nr-admin-header-left">
          <button class="nr-admin-hamburger" id="sidebar-toggle" type="button" aria-label="Toggle navigation">
            <svg viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 010 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 010 2H4a1 1 0 01-1-1zm0 5a1 1 0 011-1h12a1 1 0 010 2H4a1 1 0 01-1-1z" clip-rule="evenodd" /></svg>
          </button>
          <a class="nr-admin-logo" href={adminBase}>nobodyreads<span class="nr-dot">.</span></a>
        </div>
        <div class="nr-admin-header-right">
          <a href={siteBase} target="_blank">View site ↗</a>
          <button
            type="button"
            class="nr-admin-theme-toggle"
            data-theme-toggle
            title="Toggle theme"
            aria-label="Toggle theme"
          >
            <svg class="nr-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
            <svg class="nr-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9 6.3 6.3M17.7 17.7l1.4 1.4M19.1 4.9 17.7 6.3M6.3 17.7 4.9 19.1"/></svg>
          </button>
          <form method="POST" action={`${adminBase}/logout`} style="margin:0">
            <button type="submit" class="btn btn-ghost">Sign out</button>
          </form>
        </div>
      </header>

      <div class="nr-admin-body">
        <div class="nr-admin-sidebar-overlay" id="sidebar-overlay"></div>
        <aside class="nr-admin-sidebar" id="admin-sidebar">
          {navGroups.map((group) => (
            <>
              <div class="nr-admin-nav-section">{group.label}</div>
              {group.items.map((item) => (
                <a
                  href={item.href}
                  class:list={["nr-admin-nav-link", { active: isActive(item.href) }]}
                >
                  <Fragment set:html={navIcon(item.label)} />
                  {item.label}
                </a>
              ))}
            </>
          ))}
          <div class="nr-admin-sidebar-footer">
            <div class="nr-admin-sidebar-quote">
              &ldquo;Nobody reads it anyway — and that&rsquo;s the point.&rdquo;
            </div>
          </div>
        </aside>
        <div class="nr-admin-content">
          <slot />
        </div>
      </div>
    </div>
    ) : (
    <div class="nr-admin">
      <slot />
    </div>
    )}
    <script src="/site.js" defer></script>
    <Fragment set:html={scripts} />
    <script is:inline>
      (function () {
        var toggle = document.getElementById("sidebar-toggle");
        var sidebar = document.getElementById("admin-sidebar");
        var overlay = document.getElementById("sidebar-overlay");
        if (!toggle || !sidebar || !overlay) return;
        function openSidebar() {
          sidebar.classList.add("open");
          overlay.classList.add("open");
        }
        function closeSidebar() {
          sidebar.classList.remove("open");
          overlay.classList.remove("open");
        }
        toggle.addEventListener("click", function () {
          if (sidebar.classList.contains("open")) closeSidebar();
          else openSidebar();
        });
        overlay.addEventListener("click", closeSidebar);
      })();
    </script>
  </body>
</html>
