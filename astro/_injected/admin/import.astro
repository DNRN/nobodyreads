---
import AdminLayout from "../../layouts/AdminLayout.astro";
import ImportPanel from "../../components/admin/ImportPanel.svelte";
import { requireAdminContext } from "nobodyreads/astro/context";

const ctx = requireAdminContext(Astro.locals);
---

<AdminLayout title="Import — Admin" adminBase={ctx.adminBase} siteBase={ctx.siteBase}>
  <main class="container">
    <div class="nbr-settings">
      <header class="nbr-settings-head">
        <h2 class="nr-title nbr-settings-title">Import</h2>
        <p class="nbr-settings-sub">
          Turn an HTML page — a slide deck, an old site, a saved article — into drafts.
          The agent proposes; you accept, steer, or discard.
        </p>
      </header>

      <section class="nbr-settings-section">
        <span class="nr-eyebrow">Source</span>
        <div class="nbr-settings-card">
          <ImportPanel client:load adminBase={ctx.adminBase} />
        </div>
      </section>
    </div>
  </main>
</AdminLayout>
