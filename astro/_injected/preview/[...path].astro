---
import SiteLayout from "../../layouts/SiteLayout.astro";
import PlotPage from "../../components/PlotPage.astro";
import { requireAdminContext, requireSiteContext } from "nobodyreads/astro/context";

import {
  initDb,
  resolvePageView,
  autoReloadScript,
  previewSurface,
  getLatestSiteTemplateRevision,
  getLatestSiteTemplateRevisionId,
} from "nobodyreads";
import type { RenderTarget } from "nobodyreads";

const admin = requireAdminContext(Astro.locals);
const ctx = previewSurface(requireSiteContext(Astro.locals));

const param = new URL(Astro.request.url).searchParams.get("preview");
const viewer = {
  isOwner: true,
  member: null,
  previewAs:
    param === "public" || param === "member" || param === "owner" ? param : null,
} as const;

const db = await initDb();
const [template, revisionId] = await Promise.all([
  getLatestSiteTemplateRevision(db, ctx.tenantId),
  getLatestSiteTemplateRevisionId(db, ctx.tenantId),
]);

const segments = (Astro.params.path ?? "")
  .split("/")
  .map((segment) => segment.trim())
  .filter(Boolean);

// Mirrors the public routes: /posts/:slug is a post, anything else is a page.
// A deeper path becomes a slug containing a slash, which no slug ever is, so it
// resolves to the 404 view without needing a branch to say so.
const target: RenderTarget =
  segments.length === 2 && segments[0] === "posts"
    ? { kind: "post", slug: segments[1] }
    : { kind: "page", slug: segments.join("/") };

const view = await resolvePageView(db, ctx, viewer, target, template, Astro.response);

Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow, noai, noimageai");

if (!view.page) Astro.response.status = 404;

const reload = autoReloadScript({
  revisionId,
  endpoint: `${ctx.urlPrefix}/revision.json`,
  loginHref: admin.loginHref,
});
---
<SiteLayout options={view.layout} templateOverride={view.template}>
  <PlotPage view={view} ctx={ctx} />
  <script is:inline set:html={reload}></script>
</SiteLayout>
