---
/**
 * The call-to-action shown below a teaser.
 *
 * Rendered as a real `<form method="POST">`, not a fetch. Two reasons, both
 * deliberate: it works with JavaScript off, and it makes visible in the markup
 * that the gate is server-side. A paywall that looks like a client-side overlay
 * invites readers to try to remove it — and invites the next developer to
 * assume it *is* one.
 *
 * **`data-astro-reload` is load-bearing — do not remove it.** `SiteLayout`
 * mounts Astro's `<ClientRouter />`, which intercepts form submissions and
 * performs them with `fetch`, then swaps the resulting DOM in. Checkout answers
 * with a 303 to the payment provider's own origin, which the router cannot swap
 * — the submission collapses into a plain GET of this action URL and the reader
 * never reaches the payment page. This attribute forces a real browser
 * navigation, which is the only thing that works for an off-site redirect.
 */
import type { AccessDecision } from "../../src/payments/types.js";

interface Props {
  decision: Extract<AccessDecision, { visibility: "teaser" }>;
  /** Base for the payments API, e.g. `${urlPrefix}/api`. */
  apiBase: string;
  /** Page being gated, sent with a single-post purchase. */
  pageId: string;
  /** Where to send a signed-out reader first. */
  loginHref?: string;
  /** Whether a reader is signed in. Checkout needs an account. */
  signedIn?: boolean;
  /** Who is asking. Used in the copy; falls back to an impersonal phrasing. */
  siteName?: string;
  /**
   * What this space is called in reader-facing copy. The engine is a blog
   * engine; a host that brands its spaces differently passes its own noun.
   */
  spaceNoun?: string;
}

const {
  decision,
  apiBase,
  pageId,
  loginHref,
  signedIn = true,
  siteName,
  spaceNoun = "blog",
} = Astro.props;

function formatAmount(minorUnits: number, currency: string): string {
  return new Intl.NumberFormat("en-IE", {
    style: "currency",
    currency: currency.toUpperCase(),
  }).format(minorUnits / 100);
}

const isMembersOnly = decision.reason === "members_only";
const tier = decision.tier;
const monthly = tier?.amountMonthly != null ? formatAmount(tier.amountMonthly, decision.currency) : null;
const yearly = tier?.amountYearly != null ? formatAmount(tier.amountYearly, decision.currency) : null;
const single =
  decision.priceAmount != null ? formatAmount(decision.priceAmount, decision.currency) : null;

const checkoutAction = `${apiBase}/payments/checkout`;

const author = siteName?.trim() || `This ${spaceNoun}`;
const eyebrow = isMembersOnly ? "Members only" : "Supporters only";
const lede = isMembersOnly
  ? `Join this ${spaceNoun} to read the whole thing. It's free.`
  : `${author} writes some posts for supporters. Back this ${spaceNoun} to read the whole thing — and everything else behind the same tier.`;

const hasOffer = Boolean(tier || single);

// Where the provider should send the reader back to. Without it every purchase
// lands on the site's home page and the reader has to find the post they were
// halfway through buying. Sent as a form field rather than read from `Referer`,
// which proxies and privacy settings strip. The server re-validates it — this
// value is reader-controlled and must never become an open redirect.
const returnTo = Astro.url.pathname + Astro.url.search;
---

<aside class="nb-paywall" aria-labelledby="nb-paywall-title">
  <p class="nb-paywall__eyebrow">{eyebrow}</p>
  <h2 class="nb-paywall__title" id="nb-paywall-title">Read the rest of this post.</h2>
  <p class="nb-paywall__lede">{lede}</p>

  <div class="nb-paywall__actions">
    {isMembersOnly ? (
      <a class="site-button" href={loginHref ?? "#"}>Join</a>
    ) : !signedIn ? (
      <a class="site-button" href={loginHref ?? "#"}>Sign in to support</a>
    ) : (
      <>
        {tier && monthly && (
          <form method="POST" action={checkoutAction} data-astro-reload>
            <input type="hidden" name="return_to" value={returnTo} />
            <input type="hidden" name="scope_kind" value="tier" />
            <input type="hidden" name="scope_ref" value={tier.id} />
            <input type="hidden" name="interval" value="month" />
            <button type="submit" class="site-button">{monthly} / month</button>
          </form>
        )}
        {tier && yearly && (
          <form method="POST" action={checkoutAction} data-astro-reload>
            <input type="hidden" name="return_to" value={returnTo} />
            <input type="hidden" name="scope_kind" value="tier" />
            <input type="hidden" name="scope_ref" value={tier.id} />
            <input type="hidden" name="interval" value="year" />
            <button type="submit" class="site-button site-button--ghost">{yearly} / year</button>
          </form>
        )}
        {single && (
          <form method="POST" action={checkoutAction} data-astro-reload>
            <input type="hidden" name="return_to" value={returnTo} />
            <input type="hidden" name="scope_kind" value="page" />
            <input type="hidden" name="scope_ref" value={pageId} />
            <button type="submit" class="site-button site-button--ghost">
              Buy just this post — {single}
            </button>
          </form>
        )}
      </>
    )}
  </div>

  {!isMembersOnly && signedIn && !hasOffer && (
    <p class="nb-paywall__lede">This {spaceNoun} hasn't set up payments yet. Check back soon.</p>
  )}

  {!isMembersOnly && (
    <p class="nb-paywall__terms">
      Monthly or one-time &middot; cancel anytime &middot; no ads, no tracking &middot; you keep your data.
    </p>
  )}
</aside>

<style>
  .nb-paywall {
    margin: 2.5rem 0 1rem;
    padding: 1.875rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--bg-card);
  }

  .nb-paywall__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--link);
  }

  .nb-paywall__title {
    margin: 0.9rem 0 0;
    font-family: var(--font);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--text);
  }

  .nb-paywall__lede {
    margin: 0.75rem 0 0;
    color: var(--body-text);
    font-size: 0.94rem;
    line-height: 1.6;
  }

  .nb-paywall__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .nb-paywall__actions:empty {
    display: none;
  }

  .nb-paywall__actions form {
    margin: 0;
  }

  .nb-paywall__terms {
    margin-top: 1.5rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    font-family: var(--font-mono);
    font-size: 0.69rem;
    line-height: 1.5;
    color: var(--muted);
  }
</style>
